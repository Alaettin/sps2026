# Vorlage. Kopieren nach .env und ausfuellen; .env wird nicht eingecheckt.
#
# Achtung: dieses Verzeichnis liegt unter OneDrive. Sieht ein Wert zur Laufzeit falsch aus,
# zuerst den Zeitstempel der .env ansehen, nicht den Lesecode.

# Wo Datenbank und Dateien liegen. Im Container setzt das Dockerfile DATA_DIR=/data.
DATA_DIR=./data

PORT=3230
LOG_LEVEL=info

# Mindestens 32 Zeichen, sonst bricht der Start ab. Erzeugen zum Beispiel mit
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

SESSION_TTL_HOURS=12
MAX_UPLOAD_MB=50

# Der erste Admin. Greift nur, solange ueberhaupt kein Admin existiert.
# Beide zusammen oder keiner, sonst bricht der Start ab.
ADMIN_EMAIL=
ADMIN_PASSWORT=

# Zugang fuer Axon zur Konnektor-API (Auftrag 2). Beide zusammen oder keiner.
CONNECTOR_BASIC_USER=
CONNECTOR_BASIC_PASSWORT=

# Die oeffentliche Adresse des **Dienstes**, nicht der Vite-Port. Lokal also der Server.
PUBLIC_BASE_URL=http://localhost:3230

# Platzhalter: die Viewer-Adresse in Axon steht noch nicht fest (offener Punkt der Akte).
VIEWER_BASE_URL=https://viewer-sps2026.aas.neoception.dev/

# Angezeigter Name. Er steht einmal in der Kopfzeile, blau und gesperrt.
# "Event Manager" ist bei Neoception ein anderes Produkt und darf hier nicht auftauchen.
APP_NAME=IDTA Passport

# KI-Avatare am Terminal. Leer: der Weg ist aus, das Terminal zeigt nur die Galerie.
# Das Modell als Variable, weil OpenAI Bildmodelle stilllegt.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# Anmeldung der Besucher im DTI-Viewer: der Passport als OpenID-Connect-Anbieter fuer
# Keycloak der DTI. Client-ID, Geheimnis und Schluessel alle drei oder keiner; leer ist der Weg
# aus. Braucht PUBLIC_BASE_URL (Issuer). Geheimnis mind. 32 Zeichen. Schluessel: EC P-256 als
# PKCS8-PEM, einzeilig mit \n erlaubt. Redirect-Adressen kommagetrennt, exakt die Broker-Adresse
# aus Keycloak; leer lehnt /oauth/authorize alles ab, Discovery und JWKS laufen trotzdem.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URIS=
OIDC_SIGNATUR_SCHLUESSEL=
# Optional, gehen als Claim "roles" ins Token.
OIDC_ROLLEN=idta-passport-besucher
